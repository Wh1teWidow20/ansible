#!/bin/bash
# vCenter Credentials für Ansible
#
# WICHTIG: Diese Datei kopieren nach vcenter_credentials.sh und anpassen
# cp vcenter_credentials.sh.example vcenter_credentials.sh
#
# Dann laden mit: source vcenter_credentials.sh

export VCENTER_USERNAME="ihr-username@vsphere.local"
export VCENTER_PASSWORD="ihr-passwort"

# Optional: Ansible Vault Password (falls Sie Vault verwenden)
# export ANSIBLE_VAULT_PASSWORD_FILE="~/.ansible/vault_pass.txt"

echo "vCenter Credentials geladen für Benutzer: $VCENTER_USERNAME"
