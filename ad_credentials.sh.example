#!/bin/bash
# AD-Benutzerdaten für Ansible SSH-Zugriff
#
# WICHTIG: Diese Datei kopieren nach ad_credentials.sh und anpassen
# cp ad_credentials.sh.example ad_credentials.sh
# chmod 600 ad_credentials.sh  # Nur für Besitzer lesbar
#
# Dann laden mit: source ad_credentials.sh

# Ihr AD-Benutzername
# Verschiedene Formate möglich:
# - Einfach: "username"
# - UPN: "username@domain.com"
# - Domain: "DOMAIN\\username"
export AD_USERNAME="ihr-ad-username"

# SSH-Passwort (WARNUNG: Passwort im Klartext!)
# Alternativ: Leer lassen und --ask-pass verwenden
export ANSIBLE_PASSWORD=""

# Sudo-Passwort (meistens identisch mit SSH-Passwort)
# Alternativ: Leer lassen und --ask-become-pass verwenden
export ANSIBLE_BECOME_PASSWORD=""

# Alternative: Passwörter aus Datei lesen (sicherer)
# Erstellen Sie ~/.ansible_ssh_pass und ~/.ansible_become_pass mit Passwörtern
# Dann:
# export ANSIBLE_PASSWORD=$(cat ~/.ansible_ssh_pass)
# export ANSIBLE_BECOME_PASSWORD=$(cat ~/.ansible_become_pass)

echo "AD-Credentials für Benutzer '$AD_USERNAME' geladen"

# WICHTIG: Wenn Passwörter nicht gesetzt sind, müssen Sie --ask-pass und --ask-become-pass verwenden:
if [ -z "$ANSIBLE_PASSWORD" ]; then
    echo "⚠ ANSIBLE_PASSWORD nicht gesetzt - verwenden Sie --ask-pass"
fi

if [ -z "$ANSIBLE_BECOME_PASSWORD" ]; then
    echo "⚠ ANSIBLE_BECOME_PASSWORD nicht gesetzt - verwenden Sie --ask-become-pass"
fi
